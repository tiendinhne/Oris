# Sao chép file này thành .env rồi đổi mật khẩu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_admin_pass

# Mỗi service một tài khoản DB riêng
AUTH_DB_PASSWORD=auth_pass
POST_DB_PASSWORD=post_pass
NOTIFICATION_DB_PASSWORD=notification_pass
FEED_DB_PASSWORD=feed_pass
SEARCH_DB_PASSWORD=search_pass

# Khóa ký JWT, dùng chung cho mọi service (bước 4)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# Khóa để các service gọi nội bộ vào Notification Service, đổi thành chuỗi ngẫu nhiên dài
INTERNAL_API_KEY=doi-chuoi-nay-thanh-chuoi-ngau-nhien-cho-noi-bo
